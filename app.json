{
  "expo": {
    "name": "Viajando Manager",
    "slug": "viajando-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "viajando",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.viajando.manager"
    },
    "ios": {
      "bundleIdentifier": "com.viajando.manager"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
