{
  "expo": {
    "name": "Gestores",
    "slug": "viajando-manager",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "viajando",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.viajando.manager"
    },
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#38404D"
    },
    "ios": {
      "bundleIdentifier": "com.viajando.manager"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "964a1872-4ffc-47d2-a8a9-587e75143a2b"
      }
    },
    "owner": "yeraldgonzalez"
  }
}
